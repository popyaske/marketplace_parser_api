# =============================================================================
# Marketplace Parser API — переменные окружения
# =============================================================================
# Формат: KEY=value, без пробелов вокруг "="
# Секретные значения (токены, пароли) НЕ коммитить в git — файл .env в .gitignore
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL (используется docker-compose при инициализации БД)
# -----------------------------------------------------------------------------
# ВНИМАНИЕ: эти значения применяются ТОЛЬКО при первой инициализации volume
# postgres-data. Если меняешь пароль на существующей БД — либо удали volume
# (`docker compose down -v`), либо сделай ALTER USER внутри psql.
POSTGRES_USER=parser
POSTGRES_PASSWORD=parser
POSTGRES_DB=parser


# -----------------------------------------------------------------------------
# RabbitMQ (используется docker-compose при инициализации брокера)
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=...

# Куда публикуются результаты обычного парсинга (telegram_consumer).
# Может быть @username или числовой ID (-1001234567890).
TELEGRAM_CHANNEL_ID=@...

# Куда публикуются:
#   • daily_publisher (Такпродам)
#   • yandex_referral_publisher (рефералка Яндекс.Маркета)
#   • referral manual consumer (URL-ы из parser.referral.manual)
# Если не задан — используется TELEGRAM_CHANNEL_ID.
TELEGRAM_GROUP_ID=

# Прокси для Telegram. Нужен, если с твоего IP Telegram недоступен.
# Формат: socks5://user:pass@host:1080  или  http://user:pass@host:8080
# Оставь пустым, если не нужен.
TELEGRAM_PROXY_URL=...


# -----------------------------------------------------------------------------
# Такпродам (daily_publisher) — товары из партнёрского каталога
# -----------------------------------------------------------------------------
# Токен из ЛК Такпродам → API
TAKPRODAM_API_TOKEN=...

# ID подтверждённой площадки (status=approved) в ЛК Такпродам
#C:\Users\simon>curl -H "Authorization: Bearer 0944d43f-79d3-44d4-8189-bb07dec6a712" -H "Accept: application/json" "https://api.takprodam.ru/v2/publisher/source/?status=approved"
TAKPRODAM_SOURCE_ID=...

# Опциональный фильтр маркетплейса: Ozon | Wildberries | Avito | Aliexpress
# Пусто = без фильтра
TAKPRODAM_MARKETPLACE=

# Метка трафика в партнёрских ссылках (SubID)
TAKPRODAM_SUBID=...

# Интервал публикации (сек). 120 = 2 минуты
TAKPRODAM_PUBLISH_INTERVAL=90
# Если новых товаров нет — пауза (сек)
TAKPRODAM_EMPTY_INTERVAL=600


# -----------------------------------------------------------------------------
# Яндекс.рефералка (yandex_referral_publisher)
# -----------------------------------------------------------------------------
# 1 = любые ссылки market.yandex.ru (кроме /search) из incoming автоматически
#     уходят в parser.referral.manual → публикуются как реферальные.
# 0 = отключено, идут обычным путём.
YANDEX_AUTO_REFERRAL=1

# Интервал между циклами планировщика рефералки (секунды).
# 600 = 10 минут, 3600 = 1 час.
YANDEX_REFERRAL_INTERVAL=40

# Сколько страниц пагинации рефералки обходить за один цикл (максимум).
YANDEX_REFERRAL_MAX_PAGES=1000

# Сколько подряд пустых страниц считать концом пагинации.
YANDEX_REFERRAL_EMPTY_STREAK=3

# Целевое количество свежих товаров, которые планировщик хочет найти.
# Если найдено меньше — пойдёт по страницам дальше.
YANDEX_REFERRAL_TARGET_FRESH=1

# Пауза между постами внутри одного цикла (секунды).
# Слишком маленькая = риск бана в Telegram.
YANDEX_REFERRAL_PUBLISH_DELAY=12.0


# -----------------------------------------------------------------------------
# VK Digest — сборка клипов 9:16 и публикация
# -----------------------------------------------------------------------------
# Токен VK. Нужны права: video, wall, offline.
# Получить: https://vk.com/apps?act=manage → создать Standalone-приложение
# → в Implicit Flow выбрать права video,wall,offline.
VK_ACCESS_TOKEN=...

# Числовой ID пользователя VK (не username!). Узнать: https://vk.com/dev или
# через API users.get.
VK_USER_ID=...

# Как часто собирать и публиковать клип (секунды). 86400 = раз в сутки.
VK_DIGEST_INTERVAL=60

# Сколько фото в одном клипе (реально берётся min(накоплено, это значение)).
VK_PHOTOS_PER_VIDEO=5

# Длительность одного кадра в клипе (секунды).
VK_PHOTO_DURATION=3.0


# Размеры видео (стандарт VK Клипов — вертикаль 9:16).
VK_VIDEO_WIDTH=1080
VK_VIDEO_HEIGHT=1920

# Env-фолбэк хештегов, если VK_HASHTAGS_SOURCE=env или vk.ru/trending недоступен.
VK_HASHTAGS=#скидки,#маркетплейсы,#промокоды,#ozon,#wildberries

# Сколько хештегов добавлять в пост.
VK_HASHTAGS_COUNT=5

# Источник хештегов:
#   trending — скрапинг vk.ru/trending через CDP (обновление раз в 6ч)
#   env      — использовать VK_HASHTAGS выше
VK_HASHTAGS_SOURCE=

# Сколько страниц vk.ru/trending обходить для сбора хештегов.
VK_TRENDING_PAGES=5

# Частота обновления трендов (секунды). 21600 = 6 часов.
VK_TRENDING_REFRESH_SEC=21600

# Ссылка на Telegram-канал, которая добавляется в текст VK-поста.
VK_CHANNEL_LINK=...

# -----------------------------------------------------------------------------
# Медиа
# -----------------------------------------------------------------------------
# Корень хранилища фото/видео/музыки внутри контейнера.
# Монтируется в docker-compose.yml, менять не нужно.
MEDIA_ROOT=/app/media


# -----------------------------------------------------------------------------
# Отладка / логирование (опционально)
# -----------------------------------------------------------------------------
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# Сколько попыток подключения к БД при старте (main.py / worker.py).
DB_CONNECT_RETRIES=10
DB_CONNECT_DELAY=3.0

# Сколько попыток подключения к RabbitMQ при старте.
RMQ_CONNECT_RETRIES=10
RMQ_CONNECT_DELAY=3.0

# Только для тестов: 1 = не подключаться к БД и RabbitMQ.
TESTING=0


ADMITAD_CLIENT_ID=...
ADMITAD_CLIENT_SECRET=...
ADMITAD_WEBSITE_ID=...
ADMITAD_ALIEXPRESS_CAMPAIGN_ID=...



